{
  "schema_version": 1,
  "repository": "stevologic/stevo.ai",
  "mode": "dry-run",
  "default_branch": "main",
  "integration_branch": "development",
  "automation": {
    "merge": false,
    "close": false,
    "delete": false,
    "deploy": false
  },
  "protected_patterns": [
    "main",
    "master",
    "develop*",
    "release*",
    "gh-pages"
  ],
  "topic_prefixes": [
    "codex/",
    "dependabot/",
    "chore/",
    "cursor/",
    "agent/",
    "feature/",
    "fix/"
  ],
  "active_branches": [
    "codex/shared-maintenance-pilot",
    "codex/maintenance-contract-111",
    "codex/maintenance-compatible-dependencies"
  ],
  "locked_prs": [],
  "required_checks": [
    "validate"
  ],
  "validation_commands": [
    "npm ci",
    "npm run lint",
    "node --test scripts/test-next-eslint-root-dirs.mjs",
    "npm run typecheck",
    "npm run build",
    "node --test tests/static-export.test.mjs tests/critique-cache.test.mjs",
    "npm audit --audit-level=high",
    "npm run verify:pdf (local font/browser gate)"
  ],
  "cadences": {
    "runtime": "weekly",
    "container_images": "weekly",
    "tooling": "monthly",
    "major_review": "quarterly",
    "security": "advisory-driven; preserve PR/push checks"
  },
  "supported_image_tracks": [],
  "custom_jobs": [
    "site-critique",
    "project discovery/icons/traffic"
  ],
  "ai": {
    "provider": "xai",
    "enabled": false,
    "max_output_tokens": 1000
  }
}
