{
  "name": "stevo-ai-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "discover": "node scripts/discover-projects.mjs",
    "sync:github": "node scripts/sync-github.mjs",
    "verify:pdf": "node scripts/check-resume-pages.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "icons:projects": "node scripts/fetch-project-icons.mjs",
    "previews": "python3 scripts/capture-project-previews.py",
    "critique": "node scripts/site-critique.mjs",
    "growth": "node scripts/practice-growth.mjs",
    "optimize:portfolio": "node scripts/optimize-portfolio.mjs",
    "optimize:resume": "node scripts/optimize-resume.mjs",
    "test": "npm run build && node --test tests/static-export.test.mjs && npm run verify:pdf",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    }
  },
  "type": "module"
}
